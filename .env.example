PORT=32874
PUBLIC_ORIGIN=http://127.0.0.1:32874
SUB2API_BASE_URL=https://tokenba.com/api/v1

# Server-only admin credentials. Never expose these in frontend code.
SUB2API_ADMIN_EMAIL=
SUB2API_ADMIN_PASSWORD=

# Balance recharge storefront defaults.
CHECKOUT_DEFAULT_BALANCE_AMOUNT=20

# Optional model catalog JSON. When omitted, the frontend fallback catalog is used.
# Prices are USD per 1M tokens.
CHECKOUT_MODEL_CATALOG_JSON=

# Sync admin subscription groups into the storefront.
CHECKOUT_SYNC_GROUP_SUBSCRIPTIONS=true

# When a subscription group has no payment plan yet, the server creates one automatically.
# price = parsed group name price first, otherwise monthly_quota_usd * multiplier, not lower than min.
CHECKOUT_GROUP_PLAN_PRICE_MULTIPLIER=1
CHECKOUT_GROUP_PLAN_PRICE_MIN=1

# Optional per-group price overrides for exceptional groups. Example: 12=20,18=25
CHECKOUT_GROUP_PLAN_PRICE_OVERRIDES=

# Which storefront tier gets the highlighted style. Tiers are the first 5 sellable subscription groups after sort_order/id sorting.
CHECKOUT_POPULAR_PLAN_TIER=4

# Cleanup/polling.
CHECKOUT_CLEANUP_DELAY_MS=90000
CHECKOUT_ORDER_POLL_MS=5000

VITE_CHECKOUT_API_BASE_URL=/api/checkout

# Frontend branding and links. Change these to rebrand the page without editing code.
VITE_BRAND_NAME=TokenBa
VITE_BRAND_ICON=⚡
VITE_SITE_TITLE=TokenBa 购买
VITE_GATEWAY_BASE_URL=https://cn.tokenba.com
VITE_GATEWAY_API_URL=https://cn.tokenba.com/v1
VITE_DASHBOARD_URL=https://tokenba.com/dashboard
VITE_CHAT_NAME=TokenBa Chat
VITE_CHAT_URL=https://chat.tokenba.com
VITE_CHAT_PC_IMAGE_URL=https://img.inim.im/file/1779953515956_image.png
VITE_CHAT_MOBILE_IMAGE_URL=https://img.inim.im/file/1779953964075_image.png
VITE_CC_SWITCH_DOWNLOAD_URL=https://github.com/farion1231/cc-switch/releases/latest
