{
  "name": "api-dz-checkout",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "dev:vite": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "start": "node server/index.mjs --production",
    "preview": "node server/index.mjs --production",
    "preview:vite": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "models:sync": "node scripts/sync-model-catalog.mjs",
    "deploy": "bash deploy.sh"
  },
  "dependencies": {
    "@lucide/vue": "^1.53.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.6",
    "typescript": "~5.6.0",
    "vite": "^5.0.10",
    "vue-tsc": "^2.2.0"
  }
}
